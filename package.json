{
  "name": "shuffle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SHUFFLE: phone-first Three.js table shuffleboard",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --experimental-strip-types --no-warnings --test src/*.test.ts worker/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.137.0"
  }
}
