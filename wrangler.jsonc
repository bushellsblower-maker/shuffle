{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shuffle",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  // Hostname is config-only. GitHub Actions / Workers Builds attach this
  // custom domain on `wrangler deploy`. Zone cybush.uk must be on the account.
  "routes": [
    {
      "pattern": "shuffle.cybush.uk",
      "custom_domain": true
    }
  ],
  // Assets-only Worker: `npm run build` writes the Vite bundle to ./dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
